#!/bin/sh
# Git credential helper that answers Azure DevOps HTTPS remotes (cloud and
# on-premises Azure DevOps Server) with $AZURE_DEVOPS_EXT_PAT. Other hosts are
# left to the next helper.
[ "${1:-}" = get ] || exit 0
[ -n "${AZURE_DEVOPS_EXT_PAT:-}" ] || exit 0

protocol= host= path=
while IFS='=' read -r key value; do
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
    path) path=$value ;;
  esac
done

[ "$protocol" = https ] || exit 0
case "$host" in
  dev.azure.com | *.visualstudio.com) ;;
  *)
    # `/_git/` only appears in Azure DevOps repository paths.
    case "/$path/" in
      */_git/*) ;;
      *) exit 0 ;;
    esac
    ;;
esac

printf 'username=pat\npassword=%s\n' "$AZURE_DEVOPS_EXT_PAT"
